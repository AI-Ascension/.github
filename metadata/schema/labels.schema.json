{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical shared and scoped label definitions",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "color",
      "description"
    ],
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      },
      "color": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{6}$"
      },
      "description": {
        "type": "string",
        "maxLength": 100
      },
      "archived": {
        "type": "boolean"
      },
      "archived_at": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "repository_ids": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          ]
        }
      },
      "applicability_reason": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
