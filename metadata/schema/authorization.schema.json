{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ascension.github.io/.github/metadata/schema/authorization.schema.json",
  "title": "External metadata operation authorization",
  "type": "object",
  "required": ["authorization_id", "operator", "plan_digest", "repositories", "operations", "approval_record"],
  "properties": {
    "authorization_id": {"type": "string", "minLength": 1},
    "operator": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "minLength": 1},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repositories": {"type": "array", "minItems": 1, "items": {"type": ["string", "integer"]}},
    "operations": {"type": "array", "minItems": 1, "items": {"enum": ["topics", "labels", "rollback"]}},
    "approval_record": {
      "type": "object",
      "required": ["record_id", "reviewer", "decision"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "decision": {"const": "approved"}
      },
      "additionalProperties": true
    },
    "evidence": {"type": "object"}
  },
  "additionalProperties": true
}
