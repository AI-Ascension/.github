{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release-policy",
  "type": "object",
  "required": [
    "schema_version",
    "release_id",
    "sources",
    "contracts",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^AI-Ascension/[A-Za-z0-9_.-]+$": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "producer",
          "consumers",
          "version",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "producer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "subjects",
          "contracts",
          "receipt_sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "enum": [
              "build",
              "synthetic",
              "native-session0",
              "operations",
              "exact-host"
            ]
          },
          "subjects": {
            "type": "object",
            "minProperties": 1,
            "patternProperties": {
              "^AI-Ascension/[A-Za-z0-9_.-]+$": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            },
            "additionalProperties": false
          },
          "contracts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
