{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release-receipt",
  "type": "object",
  "required": [
    "id",
    "kind",
    "subjects",
    "contracts",
    "result",
    "completed_at",
    "runner",
    "log_path",
    "log_sha256"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "enum": [
        "build",
        "synthetic",
        "native-session0",
        "operations",
        "exact-host"
      ]
    },
    "subjects": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^AI-Ascension/[A-Za-z0-9_.-]+$": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "result": {
      "enum": [
        "passed",
        "failed",
        "unverified",
        "skipped"
      ]
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "runner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "log_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "log_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
